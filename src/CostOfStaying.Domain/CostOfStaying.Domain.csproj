<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1: portable to Unity 6 later; no Unity/FishNet references (ADR-001, TECHNICAL_ARCHITECTURE). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CostOfStaying.Domain</RootNamespace>
    <AssemblyName>CostOfStaying.Domain</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests assign internal setters (server-authoritative setters stay encapsulated per ADR-002). -->
    <InternalsVisibleTo Include="CostOfStaying.Domain.Tests" />
  </ItemGroup>

</Project>


root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

[*.{csproj,props,targets,sln,slnx}]
indent_style = space
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{xml,config,resx}]
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
